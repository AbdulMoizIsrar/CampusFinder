NODE_ENV=development
PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/campusfinder
JWT_SECRET=replace-with-a-random-minimum-32-character-secret
CSRF_SECRET=replace-with-another-random-minimum-32-character-secret
JWT_ACCESS_EXPIRES=15m
REFRESH_DAYS=7
CLIENT_ORIGIN=http://localhost:3000
CAMPUS_EMAIL_DOMAIN=
# SMTP sender; use Gmail App Password (NOT your normal login password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
SEED_DEFAULT_PASSWORD=Demo12345!
SECURITY_HELMET=true
SECURITY_RATE_LIMIT=true
SECURITY_CSRF=true
SECURITY_SANITIZE=true
